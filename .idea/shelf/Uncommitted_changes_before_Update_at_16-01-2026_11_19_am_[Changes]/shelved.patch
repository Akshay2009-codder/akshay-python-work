diff --git a/Python Practice/insertion sort.py b/Python Practice/insertion sort.py
new file mode 100644
--- /dev/null	(date 1764497939628)
+++ b/Python Practice/insertion sort.py	(date 1764497939628)
@@ -0,0 +1,11 @@
+def insertion_sort(lst):
+    for i in range(1, len(lst)):
+        key = lst[i]
+        j = i-1
+        while j >= 0 and lst[j] > key:
+            lst[j+1] = lst[j]
+            j -= 1
+            lst[j+1] = key
+        lst[j+1] = key
+    return lst
+print(insertion_sort([1,3,6,8,6,4]))
