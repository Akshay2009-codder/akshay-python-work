diff --git a/Python Practice/factorial.py b/Python Practice/factorial.py
new file mode 100644
--- /dev/null	(date 1753276720531)
+++ b/Python Practice/factorial.py	(date 1753276720531)
@@ -0,0 +1,10 @@
+#  find the factoreal of given numbers
+
+number = int(input("enter a number for find factoreal : "))
+
+def factorial(number):
+     if number == 0 or number == 1:
+         return 1
+     else:
+         return number * factorial(number-1)
+print(factorial(number))
