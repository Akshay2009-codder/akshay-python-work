--- /dev/null	(date 1764496743514)
+++ b/Python Practice/buble sort.py	(date 1764496743514)
@@ -0,0 +1,9 @@
+def buble_short(lst):
+    n = len(lst)
+    for i in range(n):
+        for j in range(0,n-i-1):
+            if lst[j] > lst[j+1]:
+                lst[j],lst[j+1] = lst[j+1],lst[j]
+    return lst
+
+print(buble_short([1,5,4,3,6,2,9,0,8,7]))
