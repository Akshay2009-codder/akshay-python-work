diff --git a/Python Practice/exeption_zero_error.py b/Python Practice/exeption_zero_error.py
new file mode 100644
--- /dev/null	(date 1753971553578)
+++ b/Python Practice/exeption_zero_error.py	(date 1753971553578)
@@ -0,0 +1,18 @@
+while True:
+    print("Enter q to exit")
+    a = input("Enter a number : ")
+    if a == "q":
+        break
+    b = input("Enter another number : ")
+    if b == "q":
+        break
+
+    try:
+        a = int(a)
+        b = int(b)
+        print(a / b)
+    except ZeroDivisionError:
+        print("any digit cannot be divided by zero")
+    except ValueError:
+        print("Please enter a valid number")
+print("Thank you for using this program")
\ No newline at end of file
