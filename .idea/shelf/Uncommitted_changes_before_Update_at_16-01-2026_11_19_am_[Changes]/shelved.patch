diff --git a/Python Practice/unique_string.py b/Python Practice/unique_string.py
new file mode 100644
--- /dev/null	(date 1760973634578)
+++ b/Python Practice/unique_string.py	(date 1760973634578)
@@ -0,0 +1,20 @@
+class Solution:
+    def lengthOfLongestSubstring(self, s: str) -> int:
+        unique = []
+        current = ""
+        for ch in s:
+            if ch in current:
+                unique.append(current)
+                current = ""
+            current += ch
+        if current:
+            unique.append(current)
+
+        length = 0
+        for substring in unique:
+            if len(substring) > length:
+                length = len(substring)
+        return length
+
+print(Solution().lengthOfLongestSubstring("dvdf"))
+
