+users = ['Akshay', 'Alka','maulik','Sahal']
+
+computers = ['Linux','Windows','iphone','mac']
+
+for i in range (0, len(users)):
+    print(f"{users[i]} is use {computers[i]} company's computer")
+
+
+print("=" * 44)
+
+
